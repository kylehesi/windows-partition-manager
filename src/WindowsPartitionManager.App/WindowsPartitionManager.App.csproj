    <OutDir Condition="'$(DevManifest)' == 'true'">bin\$(Configuration)\dev\</OutDir>
    <IntermediateOutputPath Condition="'$(DevManifest)' == 'true'">obj\$(Configuration)\dev\</IntermediateOutputPath>
