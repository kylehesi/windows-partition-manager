<Window x:Class="WindowsPartitionManager.App.OptimizeVolumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsPartitionManager.App.Controls"
        xmlns:vm="clr-namespace:WindowsPartitionManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OptimizeVolumeViewModel}"
        Title="{Binding Title}" Height="480" Width="580" MinHeight="400" MinWidth="480"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding InfoText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,14" />

        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" IsEnabled="{Binding IsFormEnabled}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Optimize_ModeLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Selected}" Padding="6,4" />
                </Grid>
                <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <Border CornerRadius="4" Padding="12,8" Margin="0,0,0,8" BorderThickness="1"
                        Visibility="{Binding HasResult, Converter={x:Static controls:Converters.BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                            <Setter Property="BorderBrush" Value="#2E9E44" />
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </Border>
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                <Run Text="{Binding Severity, Mode=OneWay, Converter={x:Static controls:Converters.Localized}, ConverterParameter=Severity_}" FontWeight="SemiBold" />
                                <Run Text=" " />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                        Visibility="{Binding HasError, Converter={x:Static controls:Converters.BoolToVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            <ProgressBar Height="6" Margin="0,6,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={x:Static controls:Converters.BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Common_Close}" Click="Close_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Optimize_Run}" Command="{Binding RunCommand}" IsDefault="True" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
