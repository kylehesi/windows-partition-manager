<Window x:Class="WindowsPartitionManager.App.ResizePartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsPartitionManager.App.Controls"
        xmlns:vm="clr-namespace:WindowsPartitionManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ResizePartitionViewModel}"
        Title="{Binding Title}" Height="640" Width="640" MinHeight="500" MinWidth="540"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding InfoText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,4" />
        <TextBlock Grid.Row="2" Text="{Binding LimitsText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" IsEnabled="{Binding IsFormEnabled}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Resize_NewSize}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding NewSizeText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="{DynamicResource Resize_Smallest}" Command="{Binding ShrinkToMinimumCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Resize_SmallestTip}" />
                <Button Grid.Column="3" Content="{DynamicResource Resize_Largest}" Command="{Binding ExtendToMaximumCommand}" ToolTip="{DynamicResource Resize_LargestTip}" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,8,0,0" IsEnabled="{Binding IsFormEnabled}">
            <StackPanel>
                <CheckBox Content="{DynamicResource Resize_CreateAfterShrink}" Foreground="{DynamicResource TextPrimary}" IsChecked="{Binding CreateAfterShrink}" />
                <Grid Margin="0,8,0,0" IsEnabled="{Binding IsCreateFormEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Common_FileSystem}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FileSystems}" SelectedItem="{Binding NewFileSystem}" Padding="6,4" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Common_Label}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8" VerticalContentAlignment="Center" MaxLength="32" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource NewPartition_DriveLetter}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Letters}" SelectedItem="{Binding SelectedLetter}" Padding="6,4" Margin="0,0,0,8" />

                    <CheckBox Grid.Row="3" Grid.Column="1" Content="{DynamicResource Common_QuickFormat}" Foreground="{DynamicResource TextPrimary}" IsChecked="{Binding NewQuickFormat}" />
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ChangeText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" " />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                        Visibility="{Binding HasError, Converter={x:Static controls:Converters.BoolToVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="6" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            <ProgressBar Height="6" Margin="0,6,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={x:Static controls:Converters.BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Common_Close}" Click="Close_Click" Margin="0,0,8,0" />
            <Button Content="{Binding ActionText}" Command="{Binding ResizeCommand}" IsDefault="True" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
