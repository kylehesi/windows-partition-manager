<Window x:Class="WindowsPartitionManager.App.UnblockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsPartitionManager.App.Controls"
        xmlns:vm="clr-namespace:WindowsPartitionManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UnblockViewModel}"
        Title="{Binding Title}" Height="600" Width="680" MinHeight="420" MinWidth="560"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,12" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:UnblockStepViewModel}">
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsSelected}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Content="{Binding Title}" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" Margin="24,2,0,6" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="24,0,0,6" />
                                <TextBlock Text="{Binding FilesText}" Style="{StaticResource Secondary}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="24,0,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,4,0,0"
                Visibility="{Binding HasError, Converter={x:Static controls:Converters.BoolToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
        </Border>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RestoreText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ProgressBar Height="6" Margin="0,6,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={x:Static controls:Converters.BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
