            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Secondary}" Margin="12,0,6,0"
                           Text="{Binding SelectionText}" />
                <StackPanel Orientation="Horizontal">
