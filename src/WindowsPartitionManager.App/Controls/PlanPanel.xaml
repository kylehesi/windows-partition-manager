<UserControl x:Class="WindowsPartitionManager.App.Controls.PlanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WindowsPartitionManager.App.Controls"
             xmlns:vm="clr-namespace:WindowsPartitionManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Visibility="{Binding IsPlanning, Converter={x:Static controls:Converters.BoolToVisibility}}">
    <!-- The pending operations queue; both main window layouts show it while changes are planned. -->
    <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Padding="16,10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Content="{DynamicResource Queue_DiscardButton}" Command="{Binding DiscardPlanCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding ApplyPlanText}" Command="{Binding ApplyPlanCommand}" FontWeight="SemiBold" BorderBrush="{DynamicResource Accent}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{DynamicResource Queue_Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlannedSteps}" AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Left" Padding="6,0" MinHeight="22" Margin="0,0,8,0" ToolTip="{DynamicResource Queue_RemoveTip}"
                                            Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                        <Run Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Mode=OneWay, Converter={x:Static controls:Converters.Ordinal}}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
