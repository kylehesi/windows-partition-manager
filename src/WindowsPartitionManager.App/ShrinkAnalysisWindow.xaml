<Window x:Class="WindowsPartitionManager.App.ShrinkAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsPartitionManager.App.Controls"
        xmlns:vm="clr-namespace:WindowsPartitionManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShrinkAnalysisViewModel}"
        Title="{Binding Title}" Height="640" Width="900" MinHeight="400" MinWidth="600"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{DynamicResource ShrinkAnalysis_Subtitle}" />

        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="{DynamicResource ShrinkAnalysis_Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource ShrinkAnalysis_Unblock}" Command="{Binding UnblockCommand}" Margin="8,0,0,0" ToolTip="{Binding UnblockText}" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource ShrinkAnalysis_Analyze}" Command="{Binding AnalyzeCommand}" Margin="8,0,0,0" IsDefault="True" />
            <TextBlock Text="{DynamicResource ShrinkAnalysis_TargetSize}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,4"
                     ToolTip="{DynamicResource ShrinkAnalysis_TargetTip}" />
        </DockPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Border Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={x:Static controls:Converters.BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
            </Border>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Secondary}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" />
            </DockPanel>
            <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="1"
                         Value="{Binding ProgressFraction, Mode=OneWay}"
                         IsIndeterminate="{Binding ProgressIndeterminate}"
                         Visibility="{Binding IsBusy, Converter={x:Static controls:Converters.BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
            <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
