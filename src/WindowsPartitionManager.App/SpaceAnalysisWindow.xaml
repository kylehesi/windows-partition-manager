<Window x:Class="WindowsPartitionManager.App.SpaceAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsPartitionManager.App.Controls"
        xmlns:vm="clr-namespace:WindowsPartitionManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SpaceAnalysisViewModel}"
        Title="{Binding Title}" Height="640" Width="860" MinHeight="420" MinWidth="640"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,10" />

        <!-- Where we are, how to go up, and the switch to the largest files of the whole drive. -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Command="{Binding UpCommand}" Padding="10,4" Margin="0,0,8,0" ToolTip="{DynamicResource Space_UpTip}">
                <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
            </Button>
            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowLargestFiles}" Content="{DynamicResource Space_LargestFiles}" VerticalAlignment="Center" Margin="12,0,0,0"
                      Foreground="{DynamicResource TextPrimary}" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource Space_OpenInExplorer}" Command="{Binding ExplorerCommand}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding Location}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
                <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Items_MouseDoubleClick" KeyDown="Items_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="10,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBackground}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SpaceItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasDetail, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                                </StackPanel>
                                <!-- Share of the current folder. -->
                                <ProgressBar Grid.Column="2" Height="8" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" VerticalAlignment="Center"
                                             Foreground="{DynamicResource Accent}" Background="{DynamicResource HeaderBackground}" BorderThickness="0" />
                                <TextBlock Grid.Column="3" Text="{Binding Size}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={x:Static controls:Converters.BoolToVisibility}}">
                <TextBlock Text="{DynamicResource Space_Loading}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,8" />
                <ProgressBar Width="240" Height="6" IsIndeterminate="True" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Border Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={x:Static controls:Converters.BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
            </Border>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Common_Close}" Click="Close_Click" IsCancel="True" />
                <Button DockPanel.Dock="Right" Content="{DynamicResource Main_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <TextBlock Text="{DynamicResource Space_Hint}" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
