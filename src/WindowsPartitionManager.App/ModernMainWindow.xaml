<Window x:Class="WindowsPartitionManager.App.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsPartitionManager.App.Controls"
        xmlns:vm="clr-namespace:WindowsPartitionManager.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Windows Partition Manager" Width="1180" Height="720" MinWidth="1020" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13">
    <!-- The modern layout: disks on the left, the selected disk in the middle, the selected
         partition's details and actions on the right. Same view model as the classic window. -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedRow}" />
        <KeyBinding Key="F2" Command="{Binding PropertiesCommand}" CommandParameter="{Binding SelectedRow}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Flat button with a glyph and a label, left aligned: sidebar navigation and partition actions. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar disk entry: a selected disk gets a tinted background and an accent bar. -->
        <Style x:Key="DiskItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextMenu" Value="{StaticResource DiskActionsMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="0,10,12,10">
                            <DockPanel>
                                <Border x:Name="Marker" DockPanel.Dock="Left" Width="3" Margin="0,4,9,4" CornerRadius="2" Background="Transparent" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBackground}" />
                                <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Partition card: free space is drawn with a dashed outline, planned partitions too. -->
        <Style x:Key="PartitionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextMenu" Value="{StaticResource RowActionsMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Rectangle x:Name="Frame" RadiusX="7" RadiusY="7" Fill="{DynamicResource CardBackground}" Stroke="{DynamicResource CardBorder}" StrokeThickness="1" />
                            <ContentPresenter Margin="14,10" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFree}" Value="True">
                                <Setter TargetName="Frame" Property="Fill" Value="Transparent" />
                                <Setter TargetName="Frame" Property="StrokeDashArray" Value="4 3" />
                                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource TextSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                <Setter TargetName="Frame" Property="StrokeDashArray" Value="4 3" />
                                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource RowHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Fill" Value="{DynamicResource RowSelectedBackground}" />
                                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Frame" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left: the disks, then what applies to the whole app. -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" />
                    <TextBlock Text="Partition Manager" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="4,0,4,8" />
                    <Button Style="{StaticResource FlatButton}" Click="Actions_Click" ToolTip="{DynamicResource Main_VirtualDiskTip}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Vhd_MenuCreate}" Icon="&#xE710;" Command="{Binding CreateVirtualDiskCommand}" />
                                <MenuItem Header="{DynamicResource Vhd_MenuAttach}" Icon="&#xE8E5;" Command="{Binding AttachVirtualDiskCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Width="26" />
                            <TextBlock Text="{DynamicResource Main_VirtualDisk}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Main_RefreshTip}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="F5" FontSize="12" Style="{StaticResource Secondary}" Margin="12,0,0,0" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Width="26" />
                            <TextBlock Text="{DynamicResource Main_Refresh}" />
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding SettingsCommand}" ToolTip="{DynamicResource Main_SettingsTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Width="26" />
                            <TextBlock Text="{DynamicResource Main_Settings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Modern_Disks}" Style="{StaticResource SectionTitle}" Margin="6,0,0,8" />
                <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" ItemContainerStyle="{StaticResource DiskItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="20" VerticalAlignment="Top" Margin="0,2,10,0" Foreground="{DynamicResource TextSecondary}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Header}" />
                                    <TextBlock Text="{Binding ShortInfo}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,1,0,6" />
                                    <ProgressBar Style="{StaticResource UsageBar}" Height="4" Value="{Binding UsedFraction, Mode=OneWay}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Middle: the selected disk. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PlanPanel Grid.Row="0" />

            <StackPanel Grid.Row="1" Margin="24,18,24,0">
                <Border Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                        Visibility="{Binding HasError, Converter={x:Static controls:Converters.BoolToVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
                </Border>

                <DockPanel DataContext="{Binding SelectedDisk}" Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Click="Actions_Click" ContextMenu="{StaticResource DiskActionsMenu}" Padding="12,4" VerticalAlignment="Center"
                            Visibility="{Binding HasActions, Converter={x:Static controls:Converters.BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Modern_DiskMenu}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasFlags, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <controls:DiskMapControl x:Name="Map" BarHeight="64" Segments="{Binding SelectedDisk.Segments}" SelectedSegment="{Binding SelectedRow.Segment}" SegmentClicked="Map_SegmentClicked" Cursor="Hand" />

                <TextBlock Text="{DynamicResource Main_PartitionsFreeSpace}" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
            </StackPanel>

            <ListBox Grid.Row="2" Style="{StaticResource BareList}" Margin="24,0,12,12" Padding="0,0,12,0"
                     ItemsSource="{Binding SelectedDisk.Rows}" SelectedItem="{Binding SelectedRow}" ItemContainerStyle="{StaticResource PartitionItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SegmentRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" Height="34" CornerRadius="2" Background="{Binding Swatch}" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}" ToolTip="{Binding EncryptionText}"
                                               Visibility="{Binding IsEncrypted, Converter={x:Static controls:Converters.BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Visibility="{Binding HasUsage, Converter={x:Static controls:Converters.BoolToVisibility}}">
                                <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding UsedFraction, Mode=OneWay}" Foreground="{Binding Swatch}" />
                                <TextBlock Text="{Binding UsageShort}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding UsageText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right: what is selected and what can be done with it. -->
        <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
            <Grid>
                <StackPanel Margin="22,24" Visibility="{Binding SelectedRow, Converter={x:Static controls:Converters.NullToVisibility}}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B3;" FontSize="28" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Modern_NoSelection}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedRow}"
                              Visibility="{Binding Converter={x:Static controls:Converters.NotNullToVisibility}}">
                    <StackPanel Margin="20,20,20,16">
                        <TextBlock Text="{DynamicResource Modern_Details}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Type}" Style="{StaticResource Secondary}" Margin="24,2,0,0" TextWrapping="Wrap" />

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasUsage, Converter={x:Static controls:Converters.BoolToVisibility}}">
                            <ProgressBar Style="{StaticResource UsageBar}" Height="8" Value="{Binding UsedFraction, Mode=OneWay}" Foreground="{Binding Swatch}" />
                            <TextBlock Text="{Binding UsageText}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,16,0,12" />
                        <TextBlock Text="{DynamicResource Col_Actions}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource Modern_NoActions}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Visibility="{Binding HasActions, Converter={x:Static controls:Converters.FalseToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Actions}" Margin="-10,0,-10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RowAction}">
                                    <Button x:Name="ActionButton" Style="{StaticResource FlatButton}" Command="{Binding Command}"
                                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontSize="12" Style="{StaticResource Secondary}" Margin="12,0,0,0" />
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Width="28" FontSize="15" />
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                            <Setter TargetName="ActionButton" Property="Foreground" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar with a coloured indicator: green idle, amber busy, red error. -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,6">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#2E9E44" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Fill" Value="#F2A900" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Fill" Value="#D13438" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
